# Local evaluation defaults. Use production, HTTPS, and PostgreSQL when hosted.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
APP_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
DATABASE_URL=sqlite:///./canvas_merger.db
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_CLIENT_ID=replace-me
CANVAS_CLIENT_SECRET=replace-me
CANVAS_ROOT_ACCOUNT_ID=1
CANVAS_ALLOWED_ACCOUNT_IDS=
CANVAS_OAUTH_SCOPES=url:GET|/api/v1/users/:user_id/profile url:GET|/api/v1/manageable_accounts url:GET|/api/v1/accounts/:id url:GET|/api/v1/accounts/:account_id/permissions url:GET|/api/v1/sections/:id url:GET|/api/v1/courses/:id url:POST|/api/v1/accounts/:account_id/courses url:POST|/api/v1/sections/:id/crosslist/:new_course_id
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
